{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/timeline-item",
  "version": "0.1.0",
  "title": "BW Timeline Item",
  "category": "kriti-blocks",
  "icon": "editor-ol",
  "description": "A single dated entry for use inside the Timeline block.",
  "example": {},
  "keywords": [
    "timeline",
    "date",
    "milestone",
    "entry"
  ],
  "parent": [
    "kriti-blocks/timeline"
  ],
  "supports": {
    "html": false
  },
  "attributes": {
    "itemDate": {
      "type": "string",
      "default": ""
    },
    "itemColor": {
      "type": "string"
    },
    "itemHighlight": {
      "type": "boolean"
    },
    "itemImageUrl": {
      "type": "string"
    },
    "itemImageId": {
      "type": "number"
    },
    "itemImageAlt": {
      "type": "string"
    },
    "itemLinkUrl": {
      "type": "string"
    },
    "itemLinkText": {
      "type": "string"
    },
    "itemLinkNewTab": {
      "type": "boolean"
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "kriti-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}