{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/feature",
  "version": "0.1.0",
  "title": "BW Feature",
  "category": "kriti-blocks",
  "icon": "star-filled",
  "description": "An icon, title, description, and optional link presented as a feature tile.",
  "example": {},
  "keywords": [
    "feature",
    "benefit",
    "icon",
    "highlight",
    "service"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "icon": {
      "type": "string",
      "default": "check"
    },
    "showIcon": {
      "type": "boolean",
      "default": true
    },
    "iconColor": {
      "type": "string",
      "default": "#4f46e5"
    },
    "iconBackground": {
      "type": "string",
      "default": "#eef2ff"
    },
    "iconSize": {
      "type": "number",
      "default": 24
    },
    "iconPosition": {
      "type": "string",
      "default": "top"
    },
    "iconShape": {
      "type": "string",
      "default": "rounded"
    },
    "contentAlign": {
      "type": "string",
      "default": "left"
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "linkText": {
      "type": "string",
      "default": ""
    },
    "linkUrl": {
      "type": "string",
      "default": ""
    },
    "linkNewTab": {
      "type": "boolean",
      "default": false
    },
    "featureImageUrl": {
      "type": "string"
    },
    "featureImageId": {
      "type": "number"
    },
    "featureImageAlt": {
      "type": "string"
    },
    "featureImageSize": {
      "type": "number"
    },
    "numberText": {
      "type": "string"
    },
    "titleTag": {
      "type": "string",
      "enum": [
        "h2",
        "h3",
        "h4",
        "h5",
        "h6",
        "p",
        "div"
      ]
    },
    "linkStyle": {
      "type": "string",
      "enum": [
        "link",
        "button",
        "outline"
      ]
    },
    "showDivider": {
      "type": "boolean"
    },
    "iconHover": {
      "type": "string",
      "enum": [
        "none",
        "scale",
        "lift",
        "rotate"
      ]
    },
    "stackOnMobile": {
      "type": "boolean"
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "kriti-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}