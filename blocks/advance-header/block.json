{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/advance-header",
  "version": "0.2.0",
  "title": "BW Advance Header",
  "category": "kriti-blocks",
  "icon": "heading",
  "description": "A heading with an optional subtitle, link, icon, colors and border.",
  "example": {},
  "keywords": [
    "header",
    "heading",
    "title"
  ],
  "supports": {
    "html": false,
    "anchor": true
  },
  "attributes": {
    "header": {
      "type": "string",
      "default": "h1",
      "enum": [
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6"
      ]
    },
    "message": {
      "type": "string",
      "default": "Heading"
    },
    "textAlign": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ]
    },
    "subtitle": {
      "type": "string"
    },
    "headerBgColor": {
      "type": "string"
    },
    "headerTextColor": {
      "type": "string"
    },
    "headerIcon": {
      "type": "string",
      "enum": [
        "chevron",
        "arrow",
        "star",
        "check",
        "plus"
      ]
    },
    "iconPosition": {
      "type": "string",
      "enum": [
        "before",
        "after"
      ]
    },
    "headerIconColor": {
      "type": "string"
    },
    "linkUrl": {
      "type": "string"
    },
    "linkNewTab": {
      "type": "boolean"
    },
    "borderStyle": {
      "type": "string",
      "default": "solid",
      "enum": [
        "solid",
        "dashed",
        "dotted",
        "double"
      ]
    },
    "borderWidth": {
      "type": "number",
      "default": 0
    },
    "borderColor": {
      "type": "string"
    },
    "borderRadius": {
      "type": "number"
    },
    "marginBottom": {
      "type": "number"
    }
  },
  "textdomain": "kriti-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}