{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/steps",
  "version": "0.1.0",
  "title": "BW Steps",
  "category": "kriti-blocks",
  "icon": "editor-ol",
  "description": "A numbered list of steps for process and how-it-works sections.",
  "example": {},
  "keywords": [
    "steps",
    "process",
    "timeline",
    "how it works",
    "numbered"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "steps": {
      "type": "array",
      "default": [
        {
          "title": "",
          "description": ""
        },
        {
          "title": "",
          "description": ""
        },
        {
          "title": "",
          "description": ""
        }
      ]
    },
    "stepsLayout": {
      "type": "string",
      "default": "vertical"
    },
    "numberStyle": {
      "type": "string",
      "enum": [
        "circle",
        "square",
        "rounded",
        "plain"
      ]
    },
    "numberFormat": {
      "type": "string",
      "enum": [
        "decimal",
        "zero",
        "alpha"
      ]
    },
    "numberSize": {
      "type": "number"
    },
    "numberBg": {
      "type": "string"
    },
    "numberColor": {
      "type": "string"
    },
    "connector": {
      "type": "boolean"
    },
    "connectorColor": {
      "type": "string"
    },
    "stepAlign": {
      "type": "string",
      "enum": [
        "left",
        "center"
      ]
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "kriti-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}