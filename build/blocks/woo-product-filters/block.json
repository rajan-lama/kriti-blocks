{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/woo-product-filters",
  "version": "0.1.0",
  "title": "BW Product Filters",
  "category": "kriti-blocks",
  "icon": "filter",
  "description": "Displays product category links and a price filter for WooCommerce product archives. Requires WooCommerce.",
  "example": {},
  "keywords": [
    "woocommerce",
    "product",
    "filters",
    "shop",
    "price",
    "category"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "showCategories": {
      "type": "boolean",
      "default": true
    },
    "categoryLimit": {
      "type": "number",
      "default": 8
    },
    "showCounts": {
      "type": "boolean",
      "default": false
    },
    "showPrice": {
      "type": "boolean",
      "default": true
    },
    "priceMin": {
      "type": "number",
      "default": 0
    },
    "priceMax": {
      "type": "number",
      "default": 0
    },
    "buttonText": {
      "type": "string",
      "default": ""
    },
    "attributeSlugs": {
      "type": "array",
      "default": []
    },
    "attributeTermLimit": {
      "type": "number",
      "default": 12
    },
    "showRating": {
      "type": "boolean",
      "default": false
    },
    "collapsible": {
      "type": "boolean",
      "default": false
    },
    "startCollapsed": {
      "type": "boolean",
      "default": false
    },
    "showActiveFilters": {
      "type": "boolean",
      "default": false
    },
    "showClearAll": {
      "type": "boolean",
      "default": true
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "kriti-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}