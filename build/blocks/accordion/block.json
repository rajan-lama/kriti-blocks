{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/accordion",
  "version": "0.1.0",
  "title": "BW Accordion",
  "category": "kriti-blocks",
  "icon": "list-view",
  "description": "A collapsible group of accordion items that can open one panel at a time.",
  "example": {},
  "keywords": [
    "accordion",
    "collapse",
    "faq",
    "tabs",
    "toggle"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "closeOthers": {
      "type": "boolean",
      "default": true
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    },
    "iconStyle": {
      "type": "string",
      "enum": [
        "chevron",
        "plus",
        "caret",
        "none"
      ]
    },
    "iconPosition": {
      "type": "string",
      "enum": [
        "right",
        "left"
      ]
    },
    "itemGap": {
      "type": "number"
    },
    "itemRadius": {
      "type": "number"
    },
    "titleColor": {
      "type": "string"
    },
    "itemBg": {
      "type": "string"
    },
    "openBg": {
      "type": "string"
    },
    "hoverBg": {
      "type": "string"
    },
    "borderColor": {
      "type": "string"
    },
    "iconColor": {
      "type": "string"
    },
    "faqSchema": {
      "type": "boolean",
      "default": false
    }
  },
  "textdomain": "kriti-blocks",
  "viewScript": "file:./view.js",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}