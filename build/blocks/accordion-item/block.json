{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/accordion-item",
  "version": "0.1.0",
  "title": "BW Accordion Item",
  "category": "kriti-blocks",
  "icon": "arrow-down-alt2",
  "description": "A single title and content panel for use inside the Accordion block.",
  "example": {},
  "keywords": [
    "accordion",
    "collapse",
    "panel",
    "toggle"
  ],
  "parent": [
    "kriti-blocks/accordion"
  ],
  "supports": {
    "html": false
  },
  "attributes": {
    "itemTitle": {
      "type": "string",
      "default": ""
    },
    "itemOpen": {
      "type": "boolean",
      "default": false
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    },
    "titleTag": {
      "type": "string",
      "default": "h3",
      "enum": [
        "h2",
        "h3",
        "h4",
        "h5",
        "h6",
        "div"
      ]
    }
  },
  "textdomain": "kriti-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}