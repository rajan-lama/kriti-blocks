{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/team-member",
  "version": "0.1.0",
  "title": "BW Team Member",
  "category": "kriti-blocks",
  "icon": "groups",
  "description": "A team member profile with photo, name, role, and short bio.",
  "example": {},
  "keywords": [
    "team",
    "member",
    "person",
    "profile",
    "staff"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "memberName": {
      "type": "string",
      "default": ""
    },
    "memberRole": {
      "type": "string",
      "default": ""
    },
    "memberBio": {
      "type": "string",
      "default": ""
    },
    "avatarUrl": {
      "type": "string",
      "default": ""
    },
    "avatarId": {
      "type": "number",
      "default": 0
    },
    "avatarAlt": {
      "type": "string",
      "default": ""
    },
    "memberAlign": {
      "type": "string",
      "default": "center"
    },
    "avatarShape": {
      "type": "string",
      "default": "round"
    },
    "hasShadow": {
      "type": "boolean",
      "default": false
    },
    "tagType": {
      "type": "string",
      "default": "div"
    },
    "photoPosition": {
      "type": "string",
      "enum": [
        "top",
        "left",
        "right"
      ]
    },
    "photoSize": {
      "type": "number"
    },
    "photoGrayscale": {
      "type": "boolean"
    },
    "nameTag": {
      "type": "string",
      "enum": [
        "h2",
        "h3",
        "h4",
        "h5",
        "h6",
        "p",
        "div"
      ]
    },
    "profileUrl": {
      "type": "string"
    },
    "profileNewTab": {
      "type": "boolean"
    },
    "socials": {
      "type": "array"
    },
    "socialNewTab": {
      "type": "boolean"
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "kriti-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}