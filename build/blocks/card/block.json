{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/card",
  "version": "0.1.0",
  "title": "BW Card",
  "category": "kriti-blocks",
  "icon": "layout",
  "description": "A card container with optional image and content area.",
  "example": {},
  "keywords": [
    "card",
    "box",
    "panel",
    "tile"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "cardImageUrl": {
      "type": "string",
      "default": ""
    },
    "cardImageId": {
      "type": "number",
      "default": 0
    },
    "cardAlign": {
      "type": "string",
      "default": ""
    },
    "cardPadding": {
      "type": "string",
      "default": "medium"
    },
    "borderRadius": {
      "type": "number",
      "default": 8
    },
    "hasShadow": {
      "type": "boolean",
      "default": false
    },
    "tagType": {
      "type": "string",
      "default": "div"
    },
    "imagePosition": {
      "type": "string",
      "enum": [
        "top",
        "left",
        "right"
      ]
    },
    "imageRatio": {
      "type": "string",
      "enum": [
        "16-9",
        "4-3",
        "3-2",
        "1-1"
      ]
    },
    "hoverEffect": {
      "type": "string",
      "enum": [
        "none",
        "lift",
        "zoom"
      ]
    },
    "badgeText": {
      "type": "string"
    },
    "badgeBg": {
      "type": "string"
    },
    "badgeColor": {
      "type": "string"
    },
    "cardLinkUrl": {
      "type": "string"
    },
    "cardLinkNewTab": {
      "type": "boolean"
    },
    "cardLinkLabel": {
      "type": "string"
    },
    "cardImageAlt": {
      "type": "string"
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "kriti-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}