{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/woo-product-reviews",
  "version": "0.1.0",
  "title": "BW Product Reviews",
  "category": "kriti-blocks",
  "icon": "editor-quote",
  "description": "Displays the customer reviews for a WooCommerce product. Requires WooCommerce.",
  "example": {},
  "keywords": [
    "woocommerce",
    "product",
    "reviews",
    "comments",
    "feedback"
  ],
  "usesContext": [
    "postId",
    "postType"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "perPage": {
      "type": "number",
      "default": 5
    },
    "order": {
      "type": "string",
      "default": "DESC"
    },
    "headingLevel": {
      "type": "number",
      "default": 3
    },
    "showTitle": {
      "type": "boolean",
      "default": true
    },
    "showRating": {
      "type": "boolean",
      "default": true
    },
    "showAvatar": {
      "type": "boolean",
      "default": true
    },
    "showDate": {
      "type": "boolean",
      "default": true
    },
    "showVerified": {
      "type": "boolean",
      "default": true
    },
    "productId": {
      "type": "number",
      "default": 0
    },
    "minRating": {
      "type": "number",
      "default": 0
    },
    "showSummary": {
      "type": "boolean",
      "default": false
    },
    "pagination": {
      "type": "boolean",
      "default": false
    },
    "showWriteLink": {
      "type": "boolean",
      "default": false
    },
    "writeLinkText": {
      "type": "string",
      "default": ""
    },
    "cardStyle": {
      "type": "string",
      "default": "default"
    },
    "avatarSize": {
      "type": "number",
      "default": 48
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "kriti-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}