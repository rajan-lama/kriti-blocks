{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/buttons",
  "version": "0.1.0",
  "title": "Buttons",
  "category": "kriti-blocks",
  "icon": "button",
  "description": "A group of buttons with link options, icons, sizes, styles and hover colors.",
  "keywords": [
    "button",
    "buttons",
    "cta",
    "link"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "buttons": {
      "type": "array",
      "default": []
    },
    "buttonLabel": {
      "type": "string",
      "default": ""
    },
    "justify": {
      "type": "string",
      "default": "left",
      "enum": [
        "left",
        "center",
        "right",
        "between"
      ]
    },
    "gap": {
      "type": "number",
      "default": 12
    },
    "direction": {
      "type": "string",
      "default": "row",
      "enum": [
        "row",
        "column"
      ]
    },
    "stackMobile": {
      "type": "boolean",
      "default": false
    }
  },
  "textdomain": "kriti-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}