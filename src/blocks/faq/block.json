{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/faq",
  "version": "0.1.0",
  "title": "BW FAQ",
  "category": "kriti-blocks",
  "icon": "editor-help",
  "description": "A list of questions and answers rendered as accessible accordion items.",
  "example": {},
  "keywords": ["faq", "accordion", "questions", "help"],
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "attributes": {
    "faqItems": {
      "type": "array",
      "default": [
        {
          "question": "",
          "answer": ""
        }
      ]
    },
    "firstOpen": {
      "type": "boolean",
      "default": false
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    },
    "iconStyle": {
      "type": "string",
      "enum": ["chevron", "plus", "caret", "none"]
    },
    "iconPosition": {
      "type": "string",
      "enum": ["right", "left"]
    },
    "itemGap": {
      "type": "number"
    },
    "itemRadius": {
      "type": "number"
    },
    "titleColor": {
      "type": "string"
    },
    "itemBg": {
      "type": "string"
    },
    "openBg": {
      "type": "string"
    },
    "hoverBg": {
      "type": "string"
    },
    "borderColor": {
      "type": "string"
    },
    "iconColor": {
      "type": "string"
    },
    "faqSchema": {
      "type": "boolean",
      "default": false
    },
    "openOne": {
      "type": "boolean",
      "default": false
    },
    "groupName": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "kriti-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}
