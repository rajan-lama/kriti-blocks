{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/quote",
  "version": "0.1.0",
  "title": "BW Quote",
  "category": "kriti-blocks",
  "icon": "format-quote",
  "description": "A styled quotation with citation and alignment controls.",
  "example": {},
  "keywords": ["quote", "blockquote", "citation", "testimonial"],
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "attributes": {
    "content": {
      "type": "string",
      "source": "html",
      "selector": "p",
      "default": ""
    },
    "citation": {
      "type": "string",
      "source": "html",
      "selector": "cite",
      "default": ""
    },
    "quoteAlign": {
      "type": "string",
      "default": ""
    },
    "quoteSize": {
      "type": "string",
      "default": "medium"
    },
    "borderColor": {
      "type": "string",
      "default": ""
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    },
    "borderSide": {
      "type": "string",
      "enum": ["left", "right", "top", "bottom", "none"]
    },
    "borderWidth": {
      "type": "number"
    },
    "showQuoteIcon": {
      "type": "boolean"
    },
    "quoteIconColor": {
      "type": "string"
    },
    "quoteColor": {
      "type": "string"
    },
    "citationColor": {
      "type": "string"
    },
    "citationStyle": {
      "type": "string",
      "enum": ["italic", "normal"]
    },
    "authorImage": {
      "type": "string"
    },
    "authorImageAlt": {
      "type": "string"
    }
  },
  "textdomain": "kriti-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}
