{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/spacer",
  "version": "0.1.0",
  "title": "BW Spacer",
  "category": "kriti-blocks",
  "icon": "image-flip-vertical",
  "description": "Add vertical space between blocks.",
  "example": {},
  "keywords": ["spacer", "space", "gap", "whitespace"],
  "supports": {
    "html": false
  },
  "attributes": {
    "spacerHeight": {
      "type": "number",
      "default": 50
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    },
    "heightUnit": {
      "type": "string",
      "enum": ["px", "rem", "vh"]
    },
    "heightTablet": {
      "type": "number"
    },
    "heightMobile": {
      "type": "number"
    }
  },
  "textdomain": "kriti-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}
