{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/pricing-table",
  "version": "0.1.0",
  "title": "BW Pricing Table",
  "category": "kriti-blocks",
  "icon": "money-alt",
  "description": "A row of pricing plan columns for packages and subscriptions.",
  "example": {},
  "keywords": ["pricing", "price", "plans", "packages", "subscription"],
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "attributes": {
    "columns": { "type": "number" },
    "columnGap": { "type": "number" },
    "naturalHeight": { "type": "boolean" },
    "stackBelow": { "type": "string", "enum": ["none", "tablet", "mobile"] },
    "billingToggle": { "type": "boolean" },
    "monthlyLabel": { "type": "string" },
    "yearlyLabel": { "type": "string" },
    "yearlyDefault": { "type": "boolean" },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "kriti-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}
