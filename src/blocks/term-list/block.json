{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/term-list",
  "version": "0.1.0",
  "title": "BW Term List",
  "category": "kriti-blocks",
  "icon": "category",
  "description": "Displays a list of categories, tags, or custom taxonomy terms.",
  "example": {},
  "keywords": ["categories", "tags", "terms", "taxonomy"],
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "attributes": {
    "taxonomy": {
      "type": "string",
      "default": "category"
    },
    "layout": {
      "type": "string",
      "default": "list"
    },
    "hierarchical": {
      "type": "boolean",
      "default": false
    },
    "hideEmpty": {
      "type": "boolean",
      "default": true
    },
    "showCount": {
      "type": "boolean",
      "default": true
    },
    "orderBy": {
      "type": "string",
      "default": "name"
    },
    "order": {
      "type": "string",
      "default": "ASC"
    },
    "limit": {
      "type": "number",
      "default": 0
    },
    "includeIds": {
      "type": "string",
      "default": ""
    },
    "excludeIds": {
      "type": "string",
      "default": ""
    },
    "topLevelOnly": {
      "type": "boolean",
      "default": false
    },
    "linkStyle": {
      "type": "string",
      "default": "auto"
    },
    "columns": {
      "type": "number",
      "default": 1
    },
    "showDescription": {
      "type": "boolean",
      "default": false
    },
    "termIcon": {
      "type": "string",
      "default": "none"
    },
    "linkColor": {
      "type": "string",
      "default": ""
    },
    "linkBg": {
      "type": "string",
      "default": ""
    },
    "hoverColor": {
      "type": "string",
      "default": ""
    },
    "hoverBg": {
      "type": "string",
      "default": ""
    },
    "countColor": {
      "type": "string",
      "default": ""
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "kriti-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
