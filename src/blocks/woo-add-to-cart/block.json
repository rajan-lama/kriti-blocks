{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/woo-add-to-cart",
  "version": "0.1.0",
  "title": "BW Add To Cart",
  "category": "kriti-blocks",
  "icon": "cart",
  "description": "Displays an add to cart button for a WooCommerce product. Requires WooCommerce.",
  "example": {},
  "keywords": ["woocommerce", "product", "cart", "button", "buy"],
  "usesContext": ["postId", "postType"],
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "attributes": {
    "text": {
      "type": "string",
      "default": ""
    },
    "buttonColor": {
      "type": "string",
      "default": ""
    },
    "textColor": {
      "type": "string",
      "default": ""
    },
    "fontSize": {
      "type": "number",
      "default": 0
    },
    "borderRadius": {
      "type": "number",
      "default": 4
    },
    "fullWidth": {
      "type": "boolean",
      "default": false
    },
    "showQuantity": {
      "type": "boolean",
      "default": false
    },
    "afterAdd": {
      "type": "string",
      "default": "default"
    },
    "hoverColor": {
      "type": "string",
      "default": ""
    },
    "hoverTextColor": {
      "type": "string",
      "default": ""
    },
    "icon": {
      "type": "string",
      "default": "none"
    },
    "iconPosition": {
      "type": "string",
      "default": "before"
    },
    "size": {
      "type": "string",
      "default": "medium"
    },
    "outOfStockText": {
      "type": "string",
      "default": ""
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "kriti-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
