{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/divider",
  "version": "0.1.0",
  "title": "BW Divider",
  "category": "kriti-blocks",
  "icon": "minus",
  "description": "A horizontal divider to visually separate content sections.",
  "example": {},
  "keywords": ["divider", "separator", "horizontal rule"],
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "attributes": {
    "dividerStyle": {
      "type": "string",
      "default": "solid"
    },
    "dividerColor": {
      "type": "string",
      "default": "#d1d5db"
    },
    "dividerWeight": {
      "type": "number",
      "default": 2
    },
    "dividerWidth": {
      "type": "number",
      "default": 100
    },
    "dividerAlign": {
      "type": "string",
      "default": "center"
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    },
    "dividerText": {
      "type": "string"
    },
    "dividerIcon": {
      "type": "string",
      "enum": ["star", "diamond", "dot", "heart"]
    },
    "labelColor": {
      "type": "string"
    },
    "widthTablet": {
      "type": "number"
    },
    "widthMobile": {
      "type": "number"
    },
    "weightMobile": {
      "type": "number"
    },
    "dividerShape": {
      "type": "string",
      "enum": ["wave", "curve", "triangle", "zigzag"]
    },
    "shapeHeight": {
      "type": "number"
    },
    "shapeFlip": {
      "type": "boolean"
    }
  },
  "textdomain": "kriti-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}
