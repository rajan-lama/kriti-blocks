{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kriti-blocks/woo-product-rating",
  "version": "0.1.0",
  "title": "BW Product Rating",
  "category": "kriti-blocks",
  "icon": "star-filled",
  "description": "Displays the customer rating for a WooCommerce product. Requires WooCommerce.",
  "example": {},
  "keywords": ["woocommerce", "product", "rating", "reviews", "stars"],
  "usesContext": ["postId", "postType"],
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "attributes": {
    "showStars": {
      "type": "boolean",
      "default": true
    },
    "showCount": {
      "type": "boolean",
      "default": true
    },
    "textAlign": {
      "type": "string",
      "default": ""
    },
    "fontSize": {
      "type": "number",
      "default": 0
    },
    "textColor": {
      "type": "string",
      "default": ""
    },
    "starIcon": {
      "type": "string",
      "default": "default"
    },
    "starColor": {
      "type": "string",
      "default": ""
    },
    "emptyStarColor": {
      "type": "string",
      "default": ""
    },
    "linkToReviews": {
      "type": "boolean",
      "default": true
    },
    "showWhenEmpty": {
      "type": "boolean",
      "default": false
    },
    "showRatingNumber": {
      "type": "boolean",
      "default": false
    },
    "countFormat": {
      "type": "string",
      "default": "text"
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "kriti-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
